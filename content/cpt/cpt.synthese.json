{
  "chapitre": "cpt.synthese",
  "notions": [
    {
      "id": "cpt.synthese.compte-resultat",
      "titre": "Établir le compte de résultat",
      "niveau": "F",
      "prerequis": [
        "cpt.mecanisme.balance",
        "cpt.inventaire.stocks"
      ],
      "connexes": [
        "gfi.performance.sig",
        "gfi.performance.caf"
      ],
      "question": "Comment passer d'une balance après inventaire à un compte de résultat lisible ?",
      "definition": "Le compte de résultat regroupe les soldes des comptes de classe 6 (charges) et 7 (produits) de l'exercice. Dans le modèle du PCG, il est organisé par niveaux : résultat d'exploitation (activité courante), résultat financier (placements, emprunts, change), résultat exceptionnel (opérations hors activité courante), puis participation des salariés et impôt sur les bénéfices, pour aboutir au résultat net.",
      "fonctionnement": [
        {
          "type": "formule",
          "formule": "Résultat courant avant impôt = Résultat d'exploitation + Résultat financier        Résultat net = Résultat courant + Résultat exceptionnel − Participation − Impôt sur les bénéfices"
        },
        {
          "type": "tableau",
          "entetes": [
            "Niveau",
            "Charges (exemples)",
            "Produits (exemples)"
          ],
          "lignes": [
            [
              "Exploitation",
              "60 Achats et variation de stocks, 61-62 Services extérieurs, 63 Impôts et taxes, 64 Personnel, 681 Dotations",
              "70 Ventes, 71 Production stockée, 74 Subventions d'exploitation, 781 Reprises"
            ],
            [
              "Financier",
              "66 Charges financières (intérêts, escomptes accordés), 686",
              "76 Produits financiers (escomptes obtenus, intérêts), 786"
            ],
            [
              "Exceptionnel",
              "67 Charges exceptionnelles (dont 675), 687",
              "77 Produits exceptionnels (dont 775), 787"
            ],
            [
              "Impôt",
              "691 Participation, 695 Impôt sur les bénéfices",
              ""
            ]
          ]
        }
      ],
      "termes": [
        {
          "fr": "Compte de résultat",
          "en": "income statement / profit and loss account",
          "es": "cuenta de pérdidas y ganancias",
          "definition": "Document de synthèse des charges et produits de l'exercice."
        },
        {
          "fr": "Résultat d'exploitation",
          "en": "operating profit / operating income",
          "es": "resultado de explotación",
          "definition": "Résultat de l'activité courante de l'entreprise."
        },
        {
          "fr": "Résultat net",
          "en": "net profit / net income",
          "es": "resultado neto / del ejercicio",
          "definition": "Résultat final après impôt."
        }
      ],
      "exemple": {
        "fictif": true,
        "texte": "Produits d'exploitation 160 000 € ; charges d'exploitation 138 500 € → résultat d'exploitation 21 500 €. Produits financiers 500 €, charges financières 1 200 € → résultat financier − 700 €. Exceptionnel : 5 000 − 4 000 = 1 000 €. Impôt 5 450 €. Résultat net : 21 500 − 700 + 1 000 − 5 450 = 16 350 €."
      },
      "confusions": [
        {
          "a": "Escompte accordé (665, financier)",
          "b": "Remise accordée (déduite des ventes, exploitation)",
          "explication": "L'escompte est classé en financier, la remise diminue le chiffre d'affaires."
        }
      ],
      "verification": [
        "Dans quel niveau du compte de résultat classe-t-on des intérêts d'emprunt ? Et une moins-value de cession ?"
      ],
      "sources": [
        "src.pcg",
        "src.anc-2022-06"
      ],
      "verifieLe": "2026-10-15",
      "aVerifier": "Le règlement ANC 2022-06 (exercices ouverts depuis le 1er janvier 2025) restreint le résultat exceptionnel et modifie la présentation : vérifier le modèle de compte de résultat utilisé en cours."
    },
    {
      "id": "cpt.synthese.bilan",
      "titre": "Établir le bilan",
      "niveau": "F",
      "prerequis": [
        "cpt.synthese.compte-resultat",
        "cpt.investissements.amortissement-lineaire",
        "cpt.inventaire.depreciations"
      ],
      "connexes": [
        "gfi.bilan-fonctionnel.reclassement"
      ],
      "question": "Comment présenter le patrimoine de l'entreprise à la clôture, une fois le résultat calculé ?",
      "definition": "Le bilan regroupe les soldes des comptes des classes 1 à 5 après inventaire. À l'actif, classé par liquidité croissante : actif immobilisé (présenté en brut, amortissements et dépréciations, net), actif circulant (stocks, créances, disponibilités), charges constatées d'avance. Au passif, classé par exigibilité croissante : capitaux propres (capital, réserves, résultat de l'exercice), provisions pour risques et charges, dettes (emprunts, fournisseurs, dettes fiscales et sociales), produits constatés d'avance. Le résultat du compte de résultat est le chiffre qui équilibre le bilan.",
      "fonctionnement": [
        {
          "type": "tableau",
          "entetes": [
            "Actif",
            "Passif"
          ],
          "lignes": [
            [
              "Actif immobilisé (brut − amortissements/dépréciations = net)",
              "Capitaux propres (dont résultat de l'exercice)"
            ],
            [
              "Actif circulant : stocks, créances (nettes de dépréciations), disponibilités",
              "Provisions pour risques et charges"
            ],
            [
              "Comptes de régularisation : charges constatées d'avance, écarts de conversion actif",
              "Dettes : emprunts, fournisseurs, fiscales et sociales ; produits constatés d'avance, écarts de conversion passif"
            ]
          ]
        },
        {
          "type": "attention",
          "texte": "Les amortissements et dépréciations (28, 29, 39, 49) ne sont pas au passif : ils viennent en diminution des actifs correspondants."
        }
      ],
      "termes": [
        {
          "fr": "Bilan",
          "en": "balance sheet / statement of financial position",
          "es": "balance (de situación)",
          "definition": "Document présentant le patrimoine à une date."
        },
        {
          "fr": "Actif immobilisé",
          "en": "non-current assets / fixed assets",
          "es": "activo no corriente / inmovilizado",
          "definition": "Biens et droits destinés à rester durablement."
        },
        {
          "fr": "Actif circulant",
          "en": "current assets",
          "es": "activo corriente",
          "definition": "Éléments liés au cycle d'exploitation et à la trésorerie."
        },
        {
          "fr": "Disponibilités",
          "en": "cash and cash equivalents",
          "es": "tesorería / efectivo",
          "definition": "Banque et caisse."
        }
      ],
      "exemple": {
        "fictif": true,
        "texte": "Matériel brut 60 000, amortissements 24 000 → net 36 000 ; stock 15 000 ; clients 18 000 − dépréciation 1 000 → 17 000 ; banque 9 000 ; CCA 1 500 : actif net 78 500 €. Passif : capital 30 000, réserves 6 150, résultat 16 350 (capitaux propres 52 500), emprunt 15 000, fournisseurs 9 200, TVA à décaisser 1 800 : 78 500 €."
      },
      "confusions": [
        {
          "a": "28154 Amortissements (diminution de l'actif)",
          "b": "151 Provisions pour risques (passif)",
          "explication": "Les amortissements corrigent la valeur d'un actif ; les provisions sont des dettes probables."
        }
      ],
      "verification": [
        "Où et comment présente-t-on la dépréciation des créances clients au bilan ?"
      ],
      "sources": [
        "src.pcg",
        "src.code-commerce"
      ],
      "verifieLe": "2026-10-15"
    }
  ],
